# Supabase Edge Functions Environment Variables
# These secrets MUST NEVER be exposed to the frontend or committed to source control.
# Set them using: supabase secrets set --env-file supabase/functions/.env.production

# Iyzico Sandbox/Production Keys
IYZICO_API_KEY=replace_with_iyzico_api_key
IYZICO_SECRET_KEY=replace_with_iyzico_secret_key
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Supabase Service Keys (Required for Admin actions like updating subscriptions)
SUPABASE_URL=replace_with_project_url
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# Optional external integrations
GEMINI_API_KEY=replace_with_server_side_key_if_testing_ai
AI_PROVIDER=gemini

# Groq API Key (Server-side primary provider secret)
GROQ_API_KEY=replace_with_server_side_groq_api_key

# OpenAI API Key (Server-side fallback/alternative secret)
OPENAI_API_KEY=replace_with_server_side_openai_api_key

# Clinic AI Assist — Multi-Provider Configuration (Primary = Groq, Fallback = OpenAI)
CLINIC_AI_TRANSCRIPTION_PROVIDER=groq
CLINIC_AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
CLINIC_AI_TRANSCRIPTION_FALLBACK_PROVIDER=openai
CLINIC_AI_TRANSCRIPTION_FALLBACK_MODEL=whisper-1

CLINIC_AI_DRAFT_PROVIDER=groq
CLINIC_AI_DRAFT_MODEL=openai/gpt-oss-120b
CLINIC_AI_DRAFT_FALLBACK_PROVIDER=openai
CLINIC_AI_DRAFT_FALLBACK_MODEL=gpt-4o-mini

CLINIC_AI_FALLBACK_ENABLED=true
